{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "version": "2.0",
  "name": "QuanLyMayBayTests",
  "url": "https://localhost:44373",
  "tests": [
    {
      "id": "tc-datve-01",
      "name": "TC_DATVE_01 - Tim chuyen mot chieu va hien thi danh sach",
      "commands": [
        {
          "id": "cmd-01-001",
          "comment": "Mo trang chu",
          "command": "open",
          "target": "https://localhost:44373/",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-01-002",
          "comment": "Set kich thuoc cua so",
          "command": "setWindowSize",
          "target": "1936x1048",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-01-003",
          "comment": "Click nut Dang nhap tren header",
          "command": "click",
          "target": "css=.bg-blue-600",
          "targets": [
            ["css=.bg-blue-600", "css"],
            ["xpath=//a[contains(@class,'bg-blue-600')]", "xpath"]
          ],
          "value": ""
        },
        {
          "id": "cmd-01-004",
          "comment": "Dien email",
          "command": "type",
          "target": "id=email",
          "targets": [["id=email", "id"]],
          "value": "khoa@gmail.com"
        },
        {
          "id": "cmd-01-005",
          "comment": "Dien mat khau",
          "command": "type",
          "target": "id=password",
          "targets": [["id=password", "id"]],
          "value": "123456"
        },
        {
          "id": "cmd-01-006",
          "comment": "Click nut Dang nhap",
          "command": "click",
          "target": "css=#userLoginForm button[type='submit']",
          "targets": [["css=#userLoginForm button[type='submit']", "css"]],
          "value": ""
        },
        {
          "id": "cmd-01-007",
          "comment": "Dien diem di",
          "command": "type",
          "target": "id=from-input",
          "targets": [["id=from-input", "id"]],
          "value": "TP.HCM"
        },
        {
          "id": "cmd-01-008",
          "comment": "Dien diem den",
          "command": "type",
          "target": "id=to-input",
          "targets": [["id=to-input", "id"]],
          "value": "Hà Nội"
        },
        {
          "id": "cmd-01-009",
          "comment": "Set ngay di la hom nay bang JS",
          "command": "executeScript",
          "target": "document.querySelector('[name=\"ngaydi\"]').value = new Date().toISOString().split('T')[0];",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-01-010",
          "comment": "Click nut Tim chuyen bay",
          "command": "click",
          "target": "css=form[action*='TimChuyen'] button[type='submit']",
          "targets": [["css=form[action*='TimChuyen'] button[type='submit']", "css"]],
          "value": ""
        },
        {
          "id": "cmd-01-011",
          "comment": "Doi ket qua hien thi - gia ve dau tien",
          "command": "waitForElementVisible",
          "target": "css=.bg-white:nth-child(1) > .p-4 .text-2xl",
          "targets": [["css=.bg-white:nth-child(1) > .p-4 .text-2xl", "css"]],
          "value": "10000"
        },
        {
          "id": "cmd-01-012",
          "comment": "Xac nhan gia ve hien thi dung - 1,950,000d",
          "command": "assertText",
          "target": "css=.bg-white:nth-child(1) > .p-4 .text-2xl",
          "targets": [["css=.bg-white:nth-child(1) > .p-4 .text-2xl", "css"]],
          "value": "1,950,000đ"
        },
        {
          "id": "cmd-01-013",
          "comment": "Dang xuat",
          "command": "executeScript",
          "target": "document.querySelector(\"a[href*='DangXuat']\").click();",
          "targets": [],
          "value": ""
        }
      ]
    },
