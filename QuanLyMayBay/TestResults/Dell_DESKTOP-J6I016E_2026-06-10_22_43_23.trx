                &lt;div&gt;&lt;label&gt;Số điện thoại *&lt;/label&gt;&lt;input type="tel" name="Passengers[0].Phone" id="p@i-phone" required=""&gt;&lt;/div&gt;&#xD;
            &lt;/div&gt;&#xD;
            &lt;div class="mb-6"&gt;&#xD;
                &lt;h3 class="text-lg font-semibold mb-4"&gt;Hành Lý - Hành Khách 1&lt;/h3&gt;&#xD;
                &lt;div class="grid grid-cols-1 md:grid-cols-2 gap-4"&gt;&#xD;
