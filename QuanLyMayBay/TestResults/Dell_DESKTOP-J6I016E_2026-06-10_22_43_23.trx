&lt;body class="bg-gray-50 font-sans"&gt;&#xD;
    &lt;!-- Header --&gt;&#xD;
    &lt;header class="bg-white shadow-sm border-b border-gray-100"&gt;&#xD;
        &lt;div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"&gt;&#xD;
            &lt;div class="flex justify-between items-center h-16"&gt;&#xD;
                &lt;!-- Logo --&gt;&#xD;
                &lt;div class="flex items-center"&gt;&#xD;
                    &lt;i class="fas fa-plane text-blue-600 text-2xl mr-3"&gt;&lt;/i&gt;&#xD;
                    &lt;span class="text-2xl font-bold text-blue-600"&gt;SkyBooking&lt;/span&gt;&#xD;
                &lt;/div&gt;&#xD;
&#xD;
&#xD;
&#xD;
                    &lt;!-- Navigation Menu --&gt;&#xD;
                    &lt;nav class="hidden md:flex space-x-8"&gt;&#xD;
                        &lt;a href="/User/TrangChu" class="navbar-item text-gray-700 hover:text-blue-600 transition-colors"&gt;&#xD;
                            Trang chủ&#xD;
                        &lt;/a&gt;&#xD;
                        &lt;a href="/User/DatVe" class="navbar-item text-gray-700 hover:text-blue-600 transition-colors"&gt;Đặt Vé&lt;/a&gt;&#xD;
                        &lt;a href="/User/VeCuaToi" class="navbar-item text-gray-700 hover:text-blue-600 transition-colors"&gt;Vé của tôi&lt;/a&gt;&#xD;
                        &lt;a href="/User/CheckIn" class="navbar-item text-gray-700 hover:text-blue-600 transition-colors"&gt;Check-in&lt;/a&gt;&#xD;
                        &lt;a href="/User/DangNhap" class="navbar-item text-gray-700 hover:text-blue-600 transition-colors"&gt;Liên hệ&lt;/a&gt;&#xD;
                    &lt;/nav&gt;&#xD;
                    &lt;!-- User Profile Dropdown --&gt;&#xD;
                    &lt;div class="flex items-center space-x-4"&gt;&#xD;
                        &lt;div class="relative group"&gt;&#xD;
                            &lt;button class="flex items-center space-x-3 bg-gray-50 hover:bg-gray-100 px-4 py-2 rounded-lg transition-colors"&gt;&#xD;
                                &lt;img src="/Content/Images/User/KH01.msi" alt="Avatar" class="w-8 h-8 rounded-full object-cover"&gt;&#xD;
                                &lt;div class="text-left hidden sm:block"&gt;&#xD;
                                    &lt;p class="text-sm font-medium text-gray-800"&gt;Nguyễn Minh Khoa&lt;/p&gt;&#xD;
                                    &lt;p class="text-xs text-gray-500"&gt;Premium Member&lt;/p&gt;&#xD;
                                &lt;/div&gt;&#xD;
                                &lt;i class="fas fa-chevron-down text-gray-500 text-sm"&gt;&lt;/i&gt;&#xD;
                            &lt;/button&gt;&#xD;
&#xD;
                            &lt;!-- Dropdown Menu --&gt;&#xD;
                            &lt;div class="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"&gt;&#xD;
                                &lt;div class="py-2"&gt;&#xD;
                                    &lt;div class="px-4 py-3 border-b border-gray-100"&gt;&#xD;
                                        &lt;p class="text-sm font-medium text-gray-800"&gt;Nguyễn Minh Khoa&lt;/p&gt;&#xD;
                                        &lt;p class="text-xs text-gray-500"&gt;khoa@gmail.com&lt;/p&gt;&#xD;
                                    &lt;/div&gt;&#xD;
                                    &lt;a href="/User/HoSo" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"&gt;&#xD;
                                        &lt;i class="fas fa-user mr-3 text-gray-400"&gt;&lt;/i&gt;Hồ sơ cá nhân&#xD;
                                    &lt;/a&gt;&#xD;
                                    &lt;a href="/User/VeCuaToi" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"&gt;&#xD;
                                        &lt;i class="fas fa-ticket-alt mr-3 text-gray-400"&gt;&lt;/i&gt;Vé của tôi&#xD;
                                    &lt;/a&gt;&#xD;
                                    &lt;a href="/User/CaiDat" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"&gt;&#xD;
                                        &lt;i class="fas fa-cog mr-3 text-gray-400"&gt;&lt;/i&gt;Cài đặt&#xD;
                                    &lt;/a&gt;&#xD;
                                    &lt;div class="border-t border-gray-100 mt-2 pt-2"&gt;&#xD;
                                        &lt;a href="/User/DangXuat" class="flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50"&gt;&#xD;
                                            &lt;i class="fas fa-sign-out-alt mr-3"&gt;&lt;/i&gt;Đăng xuất&#xD;
                                        &lt;/a&gt;&#xD;
                                    &lt;/div&gt;&#xD;
                                &lt;/div&gt;&#xD;
                            &lt;/div&gt;&#xD;
                        &lt;/div&gt;&#xD;
&#xD;
                        &lt;!-- Mobile Menu Button --&gt;&#xD;
                        &lt;button class="md:hidden text-gray-700"&gt;&#xD;
                            &lt;i class="fas fa-bars text-xl"&gt;&lt;/i&gt;&#xD;
                        &lt;/button&gt;&#xD;
                    &lt;/div&gt;&#xD;
&#xD;
&#xD;
            &lt;/div&gt;&#xD;
        &lt;/div&gt;&#xD;
    &lt;/header&gt;&#xD;
        &lt;nav class="bg-white border-b border-gray-200 sticky top-0 z-40"&gt;&#xD;
            &lt;div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"&gt;&#xD;
                &lt;div class="flex justify-between h-14"&gt;&#xD;
&#xD;
                    &lt;ul class="flex space-x-8 items-center"&gt;&#xD;
&#xD;
                        &lt;li class="relative group h-full flex items-center"&gt;&#xD;
                            &lt;button class="text-gray-700 hover:text-blue-600 font-medium flex items-center h-full"&gt;&#xD;
                                Hãng Hàng Không &lt;i class="fas fa-chevron-down ml-1 text-xs"&gt;&lt;/i&gt;&#xD;
                            &lt;/button&gt;&#xD;
